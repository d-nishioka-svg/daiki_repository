# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Injected by Cloud Run and most other hosts. Defaults to 3000 locally.
# PORT="8080"

# FIREBASE_PROJECT_ID: Used to verify the caller's Firebase ID token on
# /api/extract. Defaults to the projectId in firebase-applet-config.json, so it
# only needs setting when the deployment uses a different Firebase project.
# FIREBASE_PROJECT_ID="my-project-id"

# ALLOW_UNAUTHENTICATED_EXTRACT: Escape hatch that disables the ID token check on
# /api/extract. Only for debugging a client that cannot attach a token — while it
# is "true" anyone who knows the deployed URL can spend this project's Gemini
# quota, so leave it unset in production.
# ALLOW_UNAUTHENTICATED_EXTRACT="false"

# DAILY_REPORT_TOKEN: Bearer token for the daily-report MCP server
# (https://daily-report-henna.vercel.app/api/mcp), referenced by .mcp.json.
# Not used by this app's own code — set it in your shell/Claude Code
# environment so `claude` can substitute ${DAILY_REPORT_TOKEN} when loading
# the MCP server config. Get the token from the daily-report app.
DAILY_REPORT_TOKEN="MY_DAILY_REPORT_TOKEN"
