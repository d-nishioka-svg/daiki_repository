# このファイルをコピーして .env を作成し、実際の値を入れること。
# .env / secrets/ 以下は絶対にコミットしないこと（.gitignore 済み）。

# --- Google Calendar API (OAuth, 個人カレンダー用) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- POODLE ---
POODLE_BASE_URL=https://poodle.race.co.jp
# Google SSOログイン後のセッションを保存したPlaywright storageStateのパス
POODLE_STORAGE_STATE_PATH=./secrets/poodle-storage-state.json

# --- 固定値 ---
# 「対応トレーナー」プルダウンで選択する自分の氏名（POODLE上の表記に合わせる）
TRAINER_NAME=

# --- 実行オプション ---
# true の場合、POODLEへの書き込みを行わずログ出力のみ行う
DRY_RUN=true
